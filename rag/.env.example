# Copy to rag/.env (untracked) and fill in the key. Every slug is configuration, never code.
OPENROUTER_API_KEY=

# --- Models (checked live on 21 Nov 2026; re-check with scripts/check_models.py) ---
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
# Truncate 2,048-dim vectors to 1,024 (Matryoshka). Changing this or EMBED_MODEL means rebuilding the index.
EMBED_DIMENSIONS=1024
# Stretch: embed figure images directly instead of their captions (rebuild required)
EMBED_IMAGES=false
VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
VISION_FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
FIGURE_MODEL=nvidia/nemotron-3.5-super-vl:free
JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free
DISABLE_REASONING=true
REQUESTS_PER_MINUTE=20

# --- Vector store: memory (no Docker) or qdrant (docker compose up -d) ---
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
COLLECTION=manuals

# --- Corpus ---
# enginuity_t2 = Tier A (12 figures, 15 tables). Add ",pdf" and PDF_PATHS to ingest PDFs.
CORPORA=enginuity_t2
# Paths relative to rag/data. Page selection: file.pdf@1-40 or file.pdf@3;7-9;15
# PDF_PATHS=enginuity/task-1-component-identification/pdfs/data-7.pdf@40-60
PDF_PATHS=
# OCR for scanned pages: auto (tesseract if installed, else vision model) | tesseract | vision | none
OCR_ENGINE=auto
OCR_MAX_GARBLED=0.35
OCR_MIN_CONFIDENCE=60
OCR_MIN_CHARS=40

# --- Stage 4 levers: change ONE at a time, rebuild, re-run Layer A ---
# v1 = brief's caption prompt; v2 = richer identifiers (assembly names, variants, task)
CAPTION_PROMPT_VERSION=v1
# none | paired_figure (prefix table search text with its figure's title)
TABLE_CONTEXT=none
# 0 = vector only; e.g. 0.3 fuses BM25 for exact part numbers (no rebuild needed)
LEXICAL_WEIGHT=0.0
# Abstain when the best sourced score is below this (0 = never)
MIN_SCORE=0.0
TOP_K=5

# --- API ---
CORS_ORIGINS=http://localhost:3000
